#!/bin/sh
# Leaves LuCI and OpenClash installed; only the panel entry goes away.
[ -n "${IPKG_INSTROOT}" ] && exit 0
rm -f /tmp/wharf-openclash-luci.log /tmp/wharf-openclash-luci.status
rmdir /tmp/wharf-openclash-setup.lock 2>/dev/null
[ -x /etc/init.d/nginx ] && /etc/init.d/nginx reload >/dev/null 2>&1
exit 0
