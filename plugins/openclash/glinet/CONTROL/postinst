#!/bin/sh
# wharf-glinet-openclash (runs on the router, inside the opkg transaction).
[ -n "${IPKG_INSTROOT}" ] && exit 0

# Reload (not restart) GL.iNet's nginx so the new menu entry is picked up.
[ -x /etc/init.d/nginx ] && /etc/init.d/nginx reload >/dev/null 2>&1

# Bring LuCI up once opkg is idle. Detached: it must outlive this script and
# must not hold opkg's stdout open. Progress: /tmp/wharf-openclash-luci.status
if [ -x /usr/bin/init_luci.sh ]; then
	nohup /usr/libexec/wharf-openclash/setup-luci >/dev/null 2>&1 </dev/null &
fi
exit 0
