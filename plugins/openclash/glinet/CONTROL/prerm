#!/bin/sh
# Removing the adapter also removes the boot guard. (After a firmware upgrade the guard
# can exist without the package; it then stays until the package is installed and removed.)
[ -n "${IPKG_INSTROOT}" ] && exit 0
[ -x /etc/init.d/wharf-openclash-guard ] && /etc/init.d/wharf-openclash-guard disable >/dev/null 2>&1
exit 0
