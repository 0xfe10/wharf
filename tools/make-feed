#!/bin/sh
# Generate Packages and Packages.gz for each directory of .ipk files.
#   make-feed <feed-dir>...
set -eu
[ $# -ge 1 ] || { echo "usage: make-feed <feed-dir>..." >&2; exit 2; }
tar --version 2>/dev/null | grep -q 'GNU tar' || { echo "error: GNU tar is required" >&2; exit 1; }

for d in "$@"; do
	: > "$d/Packages"
	n=0
	for f in "$d"/*.ipk; do
		[ -e "$f" ] || continue
		[ "$n" -eq 0 ] || echo >> "$d/Packages"
		ctl=$(gzip -dc "$f" | tar -xOf - ./control.tar.gz | gzip -dc | tar -xOf - ./control)
		{
			printf '%s\n' "$ctl"
			echo "Filename: $(basename "$f")"
			echo "Size: $(wc -c < "$f" | tr -d ' ')"
			echo "SHA256sum: $(sha256sum "$f" | cut -d' ' -f1)"
		} >> "$d/Packages"
		n=$((n + 1))
	done
	gzip -9 -n -c "$d/Packages" > "$d/Packages.gz"
	echo "$d: $n package(s)"
done
