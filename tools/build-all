#!/usr/bin/env python3
"""Build the complete static opkg feed from every plugin under plugins/.

  build-all [--out site] [--build build] [--plugin NAME]

Output: <out>/feed/{*.ipk,Packages,Packages.gz}, one flat feed with every package
(upstream mirrors and wharf packages). The tag-triggered release workflow
publishes these files as the assets of the GitHub release vX.Y.Z; routers use
https://github.com/0xfe10/wharf/releases/latest/download as the feed URL.
"""
import argparse
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import wharflib as w  # noqa: E402

here = os.path.dirname(os.path.abspath(__file__))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", default=os.path.join(w.ROOT, "site"))
    ap.add_argument("--build", default=os.path.join(w.ROOT, "build"))
    ap.add_argument("--plugin")
    args = ap.parse_args()

    plugins = [p for p in w.iter_plugins() if args.plugin in (None, p["name"])]
    if not plugins:
        sys.exit("no plugins found")
    for d in (args.out, os.path.join(args.build, "stage")):
        if os.path.isdir(d):
            shutil.rmtree(d)
    stage = os.path.join(args.build, "stage")
    feed = os.path.join(args.out, "feed")
    os.makedirs(feed)

    def add(src):
        dest = os.path.join(feed, os.path.basename(src))
        if os.path.exists(dest):
            raise w.WharfError("duplicate package file %s" % os.path.basename(src))
        shutil.copy(src, dest)

    for p in plugins:
        if p.get("upstream"):
            add(w.fetch_locked(p, os.path.join(args.build, "upstream", p["name"])))
        subprocess.run([os.path.join(here, "build-ipk"), p["name"], stage], check=True, stdout=subprocess.DEVNULL)
    for cur, _, files in sorted(os.walk(stage)):
        for fn in sorted(files):
            if fn.endswith(".ipk"):
                add(os.path.join(cur, fn))
    subprocess.run([os.path.join(here, "make-feed"), feed], check=True)
    print("site written to %s" % args.out)


if __name__ == "__main__":
    try:
        main()
    except w.WharfError as e:
        sys.exit("error: %s" % e)
