#!/bin/sh
# Build every package a plugin defines (not the mirrored upstream ones).
# Each ipk goes to <out>/<feed>/.      build-ipk <plugin-name> [out-dir]
set -eu
here=$(cd "$(dirname "$0")" && pwd)
[ $# -ge 1 ] || { echo "usage: build-ipk <plugin-name> [out-dir]" >&2; exit 2; }
plugin=$1
out=${2:-$here/../build/ipk}
dir=$here/../plugins/$plugin
[ -f "$dir/plugin.json" ] || { echo "error: no such plugin: $plugin" >&2; exit 1; }
jq -r '.packages[] | "\(.name) \(.feed)"' "$dir/plugin.json" | while read -r name feed; do
	"$here/build-pkg" "$dir" "$name" "$out/$feed"
done
